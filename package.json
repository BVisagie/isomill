{
  "name": "isomill",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "bin": {
    "isomill": "./packages/compiler/dist/cli.js"
  },
  "description": "Installer compiler: Machine Definition → thin official Fedora/Ubuntu ISO with provenance on the media.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/runner"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "compile": "npm run compile -w @isomill/compiler",
    "dev:api": "npm run dev -w @isomill/api",
    "dev:web": "npm run dev -w @isomill/web",
    "build:demo": "ISOMILL_DEMO=1 npm run build:demo -w @isomill/web",
    "check:demo": "node apps/web/scripts/check-demo-export.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.46.4"
  }
}

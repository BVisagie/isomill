// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`fedora kickstart > matches the golden snapshot 1`] = `
"# Generated by isomill. Do not edit by hand.
# Based on official Fedora installer media. Not a Fedora remix and not endorsed by the Fedora Project.
# Identity and storage remain in Anaconda. This file never sets users, passwords, or disk layout.

lang en_GB.UTF-8
keyboard --vckeymap=gb
timezone Europe/Amsterdam --utc
graphical

# Allowlisted first-party vendor repositories (URLs from the isomill catalogue).
repo --name=vscode --baseurl=https://packages.microsoft.com/yumrepos/vscode --gpgcheck=1 --gpgkey=https://packages.microsoft.com/keys/microsoft.asc
repo --name=docker --baseurl=https://download.docker.com/linux/fedora --gpgcheck=1 --gpgkey=https://download.docker.com/linux/fedora/gpg

services --enabled=docker,sshd

%packages
@^workstation-product-environment
btop
code
containerd.io
docker-buildx-plugin
docker-ce
docker-ce-cli
docker-compose-plugin
git
neovim
nodejs
npm
openssh-server
python3
python3-pip
%end

%post --nochroot --erroronfail
set -euo pipefail
mkdir -p /mnt/sysimage/etc/isomill
if [ -d /run/install/repo/isomill ]; then cp -a /run/install/repo/isomill/. /mnt/sysimage/etc/isomill/; fi
%end

%post --erroronfail
set -euo pipefail
# npm allowlist — not distro-signed. --ignore-scripts is mandatory.
npm install -g --ignore-scripts @anthropic-ai/claude-code
systemctl enable docker.service
systemctl enable sshd.service
%end
"
`;

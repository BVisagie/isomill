// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ubuntu 24.04 autoinstall > matches the golden snapshot 1`] = `
"#cloud-config
autoinstall:
  version: 1
  interactive-sections:
    - identity
    - storage
  locale: en_GB.UTF-8
  keyboard:
    layout: gb
  timezone: Europe/Amsterdam
  ssh:
    install-server: true
  packages:
    - git
    - neovim
    - btop
    - python3
    - python3-pip
    - python3-venv
    - nodejs
    - npm
    - openssh-server
  late-commands:
    - curtin in-target --target=/target -- mkdir -p /etc/apt/keyrings
    - curtin in-target --target=/target -- wget -qO /etc/apt/keyrings/vscode.asc https://packages.microsoft.com/keys/microsoft.asc
    - bash -c 'echo "deb [arch=amd64] https://packages.microsoft.com/repos/code stable main" > /target/etc/apt/sources.list.d/vscode.list'
    - curtin in-target --target=/target -- apt-get update
    - curtin in-target --target=/target -- apt-get install -y code
    - curtin in-target --target=/target -- mkdir -p /etc/apt/keyrings
    - curtin in-target --target=/target -- wget -qO /etc/apt/keyrings/docker.asc https://download.docker.com/linux/ubuntu/gpg
    - bash -c 'echo "deb [arch=amd64] https://download.docker.com/linux/ubuntu noble stable" > /target/etc/apt/sources.list.d/docker.list'
    - curtin in-target --target=/target -- apt-get update
    - curtin in-target --target=/target -- apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
    - mkdir -p /target/etc/isomill
    - cp -a /cdrom/isomill/. /target/etc/isomill/
    - curtin in-target --target=/target -- npm install -g --ignore-scripts @anthropic-ai/claude-code
    - curtin in-target --target=/target -- systemctl enable docker.service
    - curtin in-target --target=/target -- systemctl enable ssh.service
"
`;
